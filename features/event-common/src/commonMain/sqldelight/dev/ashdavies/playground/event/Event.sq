import dev.ashdavies.http.common.models.EventAttrs;
import kotlin.uuid.Uuid;
import kotlinx.datetime.LocalDate;

CREATE TABLE event(
    attrs TEXT AS EventAttrs NOT NULL DEFAULT '{}',
    uuid TEXT AS Uuid NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    website TEXT NOT NULL,
    location TEXT NOT NULL,
    dateStart TEXT AS LocalDate NOT NULL,
    dateEnd TEXT AS LocalDate NOT NULL
);

countAll:
    SELECT COUNT(*) FROM event;

getAllAscending:
    SELECT * FROM event
    ORDER BY dateStart ASC, uuid ASC
    LIMIT :limit OFFSET :offset;

getAllWithNameDescending:
    WITH target AS (SELECT name, location FROM event WHERE uuid = :uuid LIMIT 1)
    SELECT event.* FROM event, target
    WHERE event.name IS target.name AND event.location IS target.location
    ORDER BY dateStart DESC, uuid DESC;

getByUuid:
    SELECT * FROM event
    WHERE uuid = :uuid;

upsert:
    INSERT OR REPLACE INTO event
    VALUES ?;

deleteAll:
    DELETE FROM event;
