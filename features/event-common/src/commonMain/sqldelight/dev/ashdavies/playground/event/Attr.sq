import kotlin.uuid.Uuid;

CREATE TABLE attr (
    parent TEXT NOT NULL,
    uuid TEXT AS Uuid NOT NULL,
    key TEXT NOT NULL,
    value TEXT NOT NULL,

    UNIQUE(parent, uuid, key)
);

upsert:
    INSERT INTO attr(parent, uuid, key, value)
    VALUES (?, ?, ?, ?)
    ON CONFLICT(parent, uuid, key) DO UPDATE SET
        value = excluded.value;
